    "fr": "^1.2.2",
    "framer-motion": "^11.14.4",
    "mini-svg-data-uri": "^1.4.4",
    "next": "15.1.0",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "react-lottie": "^1.2.10",
